# UniMate Environment Configuration Template
# Copy this to .env.local and fill in actual values
# NEVER commit .env files with actual secrets!

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_jwt_key...

# Backend API Configuration
VITE_API_URL=http://localhost:3000

# Optional: Gemini API Key (backend only, NEVER in frontend)
# Note: This goes in Supabase Edge Functions secrets, not here
VITE_GEMINI_API_KEY=sk-...your_api_key_here...
s
# Environment Mode
NODE_ENV=development
