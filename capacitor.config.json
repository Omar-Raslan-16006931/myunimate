{
  "appId": "com.omarraslan.unimate",
  "appName": "UniMate",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0f0f16"
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": [
